{
  "name": "thate-pdf-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @pdf-visual",
    "test:all": "npm test && npm run typecheck && npm run test:e2e && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
